# The pinned @cloudflare/workers-types v4 (which tsconfig's `types` array expects)
# and wrangler's own peerOptional on workers-types v5 disagree, so a bare
# `npm install` ERESOLVEs and fails the build. This project has always been
# installed with `--legacy-peer-deps`; putting it here makes that automatic for
# every clone, and — the reason it matters — for Cloudflare's Git builder, which
# runs its own `npm install` and would otherwise fail this Worker's first deploy.
legacy-peer-deps=true
