{
  "name": "home",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:local": "node scripts/db-migrate.mjs --local",
    "db:remote": "node scripts/db-migrate.mjs --remote",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/**/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "audit:remote": "node scripts/schema-audit.mjs",
    "audit:rules": "node scripts/rule-guards-audit.mjs",
    "audit:laoka-types": "node scripts/laoka-types-audit.mjs",
    "audit:module-state": "node scripts/module-state-audit.mjs",
    "audit:do-state": "node scripts/do-state-audit.mjs",
    "audit:basemaps": "node scripts/basemap-record-audit.mjs",
    "basemaps:record": "node scripts/basemap-record.mjs",
    "verify": "npm run check && npm test && npm run smoke",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.42.0"
  }
}
